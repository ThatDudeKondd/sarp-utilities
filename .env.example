BOT_TOKEN = "your_discord_bot_token_here"
CLIENT_ID = your_client_id_here
CLIENT_SECRET = your_client_secret_here
ERLC_API_KEY = your_erlc_api_key_here
DEBUG = false

# PostgreSQL Database URL (for Prisma)
DATABASE_URL = "postgresql://user:password@localhost:5432/sarp_bot"
VEXIRA_PORTFOLIO_KEY = your_vexira_portfolio_key_here
SUPER_ADMIN_ID = your_discord_user_id_here

# djsko owner console. Comma-separated Discord user IDs, no spaces/quotes
# (Docker --env-file is strict). Unset = console disabled, not app-owner fallback.
JSK_OWNERS=
JSK_SHELL_OWNERS=
# Role pinged on command-error logs (optional)
ERROR_ALERT_ROLE_ID=

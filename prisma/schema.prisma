// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Guild configuration stored per guild
model GuildConfig {
  id      String @id @default(cuid())
  guildId String @unique

  prefix          String  @default("-")
  modLogChannelId String?

  directiveRoles     String[]
  seniorHrRoles      String[]
  managementRoles    String[]
  supervisorRoles    String[]
  administratorRoles String[]
  moderatorRoles     String[]

  infractionChannel String? @default("")
  logsChannel       String? @default("")
  erlcLogChannel    String? @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_configs")
}

// Command cooldowns to prevent spam
model CommandCooldown {
  id          String   @id @default(cuid())
  userId      String
  commandName String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, commandName])
  @@map("command_cooldowns")
}

// Structured infraction records, one row per punishment issued via /infract
model Infraction {
  id          String   @id @default(cuid())
  caseNumber  Int      @unique @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  punishment  String
  reason      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([guildId])
  @@map("infractions")
}

// User data (optional, for infractions/warnings)
model User {
  id          String       @id @default(cuid())
  userId      String       @unique
  // Not unique: a rename can briefly leave two rows holding the same name
  // until the other member is next synced.
  username    String
  roles       String[]     @default([])
  guilds      String[]     @default([])
  infractions Infraction[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}

// Cross-server role sync: holding sourceRoleId in sourceGuildId grants
// targetRoleId in targetGuildId. Two links (one each way) = bidirectional.
model RoleLink {
  id            String @id @default(cuid())
  sourceGuildId String
  sourceRoleId  String
  targetGuildId String
  targetRoleId  String

  @@unique([sourceGuildId, sourceRoleId, targetGuildId, targetRoleId])
  @@index([sourceGuildId])
  @@index([targetGuildId])
  @@map("role_links")
}

{
  "name": "sarp-utilities",
  "version": "1.0.0",
  "description": "Discord bot written in TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "nodemon --exec tsx src/index.ts",
    "dev:test": "DOTENV_CONFIG_PATH=.env.test nodemon --exec tsx src/index.ts",
    "db:push:test": "DOTENV_CONFIG_PATH=.env.test prisma db push && prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts",
    "db:studio": "BROWSER=none prisma studio",
    "db:gen": "npx prisma generate",
    "db:format": "npx prisma format",
    "db:update": "npm run db:format && npm run db:push && npm run db:gen"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.8.0",
    "@sentry/profiling-node": "^11.8.0",
    "discord.js": "^14.14.0",
    "djsko": "github:ThatDudeKondd/djsko",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pm2": "^7.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.2",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "djsko": true,
    "djsko@0.5.0": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
